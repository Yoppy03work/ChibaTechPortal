# === ChibaTechPortal テスト用環境変数 ===
# CI/ローカルテストで使用する固定値。本番シークレットは含まない。

# --- データベース ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chibatech_portal_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- 暗号化 ---
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- 認証 ---
JWT_SECRET=test-jwt-secret-key-at-least-32-characters-long
AUTH_SECRET=test-auth-secret-for-testing
REFRESH_TOKEN_PEPPER=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Next.js ---
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=test

# --- Push通知 (テスト用ダミー) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BDummy_test_vapid_public_key_placeholder_00000000000000000000000000000000000000
VAPID_PRIVATE_KEY=dummy_test_vapid_private_key_placeholder
VAPID_SUBJECT=mailto:test@example.com

# --- メール ---
RESEND_API_KEY=re_test_dummy_key

# --- E2Eテスト ---
E2E_TEST_STUDENT_ID=T00E0001
E2E_TEST_PASSWORD=e2e-test-password-2026
