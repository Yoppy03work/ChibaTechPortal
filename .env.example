# === ChibaTechPortal 環境変数テンプレート ===
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# --- 暗号化 ---
# AES-256-GCM マスターキー（64文字のHex = 256bit）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# --- 認証 ---
# JWT署名シークレット（32文字以上）
JWT_SECRET=

# Auth.js シークレット
AUTH_SECRET=

# Refresh Token HMAC-SHA256 用 pepper（64文字のHex = 256bit）
# 生成: openssl rand -hex 32
# WHY: DB に保存されるのは HMAC ハッシュのみ。pepper は DB と分離して秘匿する。
REFRESH_TOKEN_PEPPER=

# --- データベース ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chibatech_portal

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Push通知 (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- メール (Resend) ---
RESEND_API_KEY=

# --- Next.js ---
NEXTAUTH_URL=http://localhost:3000
# WHY: メール通知内リンクのベース URL。未設定なら http://localhost:3000。
APP_BASE_URL=http://localhost:3000

# --- プロキシ / IP 抽出 ---
# WHY: x-forwarded-for はクライアントが偽装できるため、trusted なリバースプロキシ
# 経由でのみアプリに到達する構成で「true」に設定する。未設定の場合 getClientIp()
# は常に null を返し、IP ベースのレートリミットはスキップされる（sid ベースのみ残る）。
TRUST_X_FORWARDED_FOR=
# WHY: アプリの前段にあるプロキシ段数。x-forwarded-for の右端から N 番目を
# クライアントIPとして採用する。不正値（非負整数以外）で起動失敗する。
TRUSTED_PROXY_COUNT=1

# --- スクレイピング ---
# WHY: CIT Portal / manaba への定期スクレイピングの ON/OFF。既定 false で外部アクセス
# しない（dark default）。自分用に取り込みを有効化するときのみ true。テスト/ドライランでは
# false のままにして意図しない外部アクセスを防ぐ。
SCRAPE_ENABLED=false
# WHY: 取り込み元のベース URL。別キャンパス/セルフホストや stub で上書き可能（既定は CIT）。
# CIT_PORTAL_BASE_URL=https://portal.chibatech.ac.jp/uprx
# MANABA_BASE_URL=https://cit.manaba.jp

# --- CIT 時間割の SSO 自動同期 (env ベース・単一ユーザー phase0) ---
# WHY: 在学生ログインは統合認証(Keycloak + MFA/TOTP)。worker が無人同期するには TOTP secret が
# 必要だが、DB に置くと漏洩時に MFA を素通りされるため secret は **コンテナ env/secret** に置く
# (DB には入れない)。専用 TOTP デバイス登録 + 専用コンテナ運用が前提。すべて既定オフ(fail-closed)。
# CIT_TIMETABLE_SYNC_ENABLED=false       # 時間割同期の専用ゲート (SCRAPE_ENABLED と両方 true で起動)
# CIT_NOTIFICATIONS_SYNC_ENABLED=false   # 掲示板お知らせ同期の専用ゲート (同上・新着は push 通知)
# CIT_PORTAL_USER_ID=                    # 統合認証 username (学籍 ID)
# CIT_PORTAL_PASSWORD=                   # 統合認証パスワード
# CIT_PORTAL_TOTP_SECRET=                # 認証アプリの BASE32 シークレット (表示の空白は自動除去)
# CIT_PORTAL_TOTP_DEVICE=                # (任意) 複数 TOTP デバイス時に選ぶデバイス名の部分一致
# CIT_PORTAL_SYNC_USER_ID=               # 同期先 DB User.id (syncTimetable 対象)
# WHY: スケジューラの稼働時間帯（時, 0-24, 既定 7-22）。この帯のみ scrape を行う。
# ATTENDANCE_ACTIVE_HOURS_START=7
# ATTENDANCE_ACTIVE_HOURS_END=22

# --- 出席リマインダ ---
# WHY: confirm モードで授業開始の少し前 (既定 10 分前) に「アプリを開いて出席を送信」
# push を送る。既定オフ。自分用に有効化するときのみ true。
CONFIRM_REMINDER_ENABLED=false

# --- 出席 auto 解禁 (段階・既定オフ・最高リスク) ---
# WHY: auto 実送信はリポジトリ最高リスク。dry-run → allowlist 単一 → full の段階で解禁する。
# 何も設定しなければ auto は走らない。空 allowlist は「誰も許可しない」(fail-closed)。
# ATTENDANCE_AUTO_EXECUTION_ENABLED=    # マスターキルスイッチ (true で auto 経路が生きる)
# ATTENDANCE_AUTO_ALLOWLIST=            # 解禁する userId のカンマ区切り
# ATTENDANCE_AUTO_ALLOWLIST_ALL=        # true で全員許可 (本番全解禁・明示 opt-in)
# ATTENDANCE_AUTO_DRY_RUN=              # true で全 guard 通すが attend は no-op (検証用)

# --- 出席 / ローカル検証 (任意・dev のみ) ---
# WHY: 既定は本番 CIT 出席システム。ローカルで stub サーバに向けたい場合のみ上書きする。
# ATTENDANCE_BASE_URL=https://attendance.is.it-chiba.ac.jp
# WHY: ATTENDANCE_ADAPTER=mock にすると healthCheck=true で confirm/auto の全経路を
# CIT_Wi-Fi なしに流せる（実外部 HTTP なし）。production では起動時 throw する。
# 結果は ATTENDANCE_MOCK_RESULT で制御 (success | fail | no-class、既定 success)。
# ATTENDANCE_ADAPTER=
# ATTENDANCE_MOCK_RESULT=success

# --- E2Eテスト ---
E2E_TEST_STUDENT_ID=
E2E_TEST_PASSWORD=
