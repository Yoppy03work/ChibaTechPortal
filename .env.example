# === ChibaTechPortal 環境変数テンプレート ===
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# --- 暗号化 ---
# AES-256-GCM マスターキー（64文字のHex = 256bit）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# --- 認証 ---
# JWT署名シークレット（32文字以上）
JWT_SECRET=

# Auth.js シークレット
AUTH_SECRET=

# Refresh Token HMAC-SHA256 用 pepper（64文字のHex = 256bit）
# 生成: openssl rand -hex 32
# WHY: DB に保存されるのは HMAC ハッシュのみ。pepper は DB と分離して秘匿する。
REFRESH_TOKEN_PEPPER=

# --- データベース ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chibatech_portal

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Push通知 (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- メール (Resend) ---
RESEND_API_KEY=

# --- Next.js ---
NEXTAUTH_URL=http://localhost:3000

# --- プロキシ / IP 抽出 ---
# WHY: x-forwarded-for はクライアントが偽装できるため、trusted なリバースプロキシ
# 経由でのみアプリに到達する構成で「true」に設定する。未設定の場合 getClientIp()
# は常に null を返し、IP ベースのレートリミットはスキップされる（sid ベースのみ残る）。
TRUST_X_FORWARDED_FOR=
# WHY: アプリの前段にあるプロキシ段数。x-forwarded-for の右端から N 番目を
# クライアントIPとして採用する。不正値（非負整数以外）で起動失敗する。
TRUSTED_PROXY_COUNT=1

# --- スクレイピング ---
# WHY: CIT Portal / manaba への定期スクレイピングの ON/OFF。既定 false で外部アクセス
# しない（dark default）。自分用に取り込みを有効化するときのみ true。テスト/ドライランでは
# false のままにして意図しない外部アクセスを防ぐ。
SCRAPE_ENABLED=false

# --- E2Eテスト ---
E2E_TEST_STUDENT_ID=
E2E_TEST_PASSWORD=
