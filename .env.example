# === ChibaTechPortal 環境変数テンプレート ===
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# --- 暗号化 ---
# AES-256-GCM マスターキー（64文字のHex = 256bit）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# --- 認証 ---
# JWT署名シークレット（32文字以上）
JWT_SECRET=

# Auth.js シークレット
AUTH_SECRET=

# --- データベース ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chibatech_portal

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Push通知 (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- メール (Resend) ---
RESEND_API_KEY=

# --- Next.js ---
NEXTAUTH_URL=http://localhost:3000

# --- E2Eテスト ---
E2E_TEST_STUDENT_ID=
E2E_TEST_PASSWORD=
